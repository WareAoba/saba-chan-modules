            "null"
          ]
        },
        "crash_artifacts": {
          "default": [],
          "description": "크래시 때 생기는 파일 (작업 디렉터리 기준, 마지막 칸만 `*` `?`)",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "dir_signatures": {
          "default": null,
          "description": "디렉토리 내 파일/폴더 시그니처 — 전부 있어야 이 게임의 서버 폴더로 본다",
