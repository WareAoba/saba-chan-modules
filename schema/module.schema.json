        },
        "label": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "소문자·숫자·`-`·`_` (모듈 안에서 겹치지 않음). 액션 id는 `server.query:<name>`",
          "type": "string"
        }
      },
      "required": [
        "function",
        "name"
      ],
      "type": "object"
