          "default": {},
          "description": "컴포넌트 의존성 — 이 모듈이 요구하는 다른 컴포넌트의 최소 버전 예: { \"saba-core\" = \">=0.3.0\", \"ext-steamcmd\" = \">=1.0.0\" }",
          "type": "object"
        },
        "description": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "display_name": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "entry": {
          "description": "모듈 폴더 기준 Python 진입 파일 (예: \"lifecycle.py\")",
          "type": "string"
        },
        "game_name": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "icon": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "log_pattern": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "모듈 id (폴더 이름과 같게)",
          "type": "string"
        },
        "schema_version": {
          "default": null,
          "description": "이 파일이 따르는 스키마 버전. 지금은 1",
          "enum": [
            1,
            null
          ]
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "entry",
        "name",
        "version"
      ],
      "type": "object"
    },
    "OneOrMany": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      ],
