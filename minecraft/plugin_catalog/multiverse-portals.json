{
  "name": "Multiverse-Portals",
  "match": [
    "Multiverse-Portals"
  ],
  "docs": [
    "https://mvplugins.org/portals/fundamentals/commands-usage/",
    "https://github.com/Multiverse/Multiverse-Portals/tree/main/src/main/java/org/mvplugins/multiverse/portals/commands"
  ],
  "player_only": [
    "mvp create",
    "mvp select",
    "mvp wand",
    "mvp debug"
  ],
  "commands": [
    {
      "name": "mvp-list",
      "label": "List portals",
      "description": "Displays a listing of all portals that you can enter.",
      "risk": "safe",
      "console_template": "mvp list {filter}",
      "inputs": [
        {
          "name": "filter",
          "type": "text",
          "label": "Filter / page",
          "required": false,
          "placeholder": "Name or world filter, then optional page"
        }
      ]
    },
    {
      "name": "mvp-info",
      "label": "Portal info",
      "description": "Displays information about a portal.",
      "risk": "safe",
      "console_template": "mvp info {portal}",
      "inputs": [
        {
          "name": "portal",
          "type": "text",
          "label": "Portal",
          "required": true,
          "placeholder": "Portal name"
        }
      ]
    },
    {
      "name": "mvp-modify",
      "label": "Modify portal",
      "description": "Modifies a value of a portal.",
      "risk": "caution",
      "console_template": "mvp modify {portal} {property} {value}",
      "inputs": [
        {
          "name": "portal",
          "type": "text",
          "label": "Portal",
          "required": true,
          "placeholder": "Portal name"
        },
        {
          "name": "property",
          "type": "text",
          "label": "Property",
          "required": true,
          "placeholder": "e.g. dest"
        },
        {
          "name": "value",
          "type": "text",
          "label": "Value",
          "required": true
        }
      ]
    },
    {
      "name": "mvp-remove",
      "label": "Remove portal",
      "description": "Removes an existing portal.",
      "risk": "danger",
      "console_template": "mvp remove {portal}",
      "inputs": [
        {
          "name": "portal",
          "type": "text",
          "label": "Portal",
          "required": true,
          "placeholder": "Portal name"
        }
      ]
    },
    {
      "name": "mvp-config",
      "label": "Config",
      "description": "Sets or shows global Multiverse-Portals config values.",
      "risk": "danger",
      "console_template": "mvp config {property} {value}",
      "inputs": [
        {
          "name": "property",
          "type": "text",
          "label": "Property",
          "required": true
        },
        {
          "name": "value",
          "type": "text",
          "label": "Value",
          "required": false,
          "placeholder": "Leave empty to show the current value"
        }
      ]
    }
  ]
}
