          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "color",
        "name",
        "pattern"
      ],
      "type": "object"
    },
    "InstallSectionToml": {
      "additionalProperties": false,
      "description": "module.toml [install] 섹션",
      "properties": {
        "anonymous": {
          "default": null,
          "type": [
            "boolean",
            "null"
          ]
        },
        "app_id": {
          "default": null,
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "beta": {
          "default": null,
          "description": "설치할 베타 브랜치 (지정하면 항상 이 브랜치로 설치)",
          "type": [
            "string",
            "null"
          ]
        },
        "download_url": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "install_subdir": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "method": {
          "default": null,
          "description": "\"manual\"(기본) | \"download\" | \"steamcmd\"",
          "type": [
            "string",
            "null"
          ]
        },
        "platform": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "requires_extensions": {
          "default": [],
          "description": "이 설치 방식이 요구하는 익스텐션 ID 목록 예: requires_extensions = [\"steamcmd\"]",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "LaunchSection": {
      "additionalProperties": false,
      "properties": {
        "console": {
          "allOf": [
            {
              "$ref": "#/definitions/ConsoleMode"
            }
          ],
          "default": "pipe",
          "description": "\"pipe\"(기본) | \"pty\". 출력을 파이프로 주면 끝날 때까지 모아 두는 서버(stdout 블록 버퍼링)는 \"pty\"로 의사 콘솔(Windows ConPTY)에 띄워 줄마다 받는다. stdout과 stderr가 한 갈래로 합쳐진다."
        },
        "log_files": {
          "default": [],
          "description": "서버가 콘솔 대신 파일에 쓰는 로그 (작업 디렉터리 기준, 마지막 칸만 `*` `?`)",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "ModuleAgreement": {
      "additionalProperties": false,
      "description": "`[[agreements]]` — 사용자가 원문을 읽고 동의해야 서버를 켤 수 있는 약관. 이름은 모듈 locales의 `agreements.<id>`, 동의는 인스턴스 레코드 `accepted_agreements`에 남는다",
      "properties": {
        "id": {
          "description": "소문자·숫자·`-`·`_` (모듈 안에서 겹치지 않음, 예: \"eula\")",
          "type": "string"
        },
        "url": {
          "description": "사용자가 읽을 원문 (https)",
          "type": "string"
        }
      },
      "required": [
        "id",
        "url"
      ],
      "type": "object"
    },
    "ModuleBackup": {
      "additionalProperties": false,
      "description": "`[backup]` — 무엇을 백업할지",
      "properties": {
        "hook": {
          "default": false,
          "description": "true면 lifecycle `backup_paths(config)`가 `{\"success\": true, \"paths\": [...]}`로 경로를 준다 (세이브 위치를 모듈 코드가 계산하는 게임용). `paths`에 더해진다",
          "type": "boolean"
        },
        "paths": {
          "default": [],
          "description": "백업할 폴더·파일 (서버 작업 폴더 기준, 절대 경로 가능). `{설정 이름}`은 인스턴스 설정 값으로 바뀌고 값이 비면 그 경로는 빠진다. 없는 경로도 빠진다. 예: [\"{level_name}\", \"{level_name}_nether\"]",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "save_command": {
          "description": "서버가 켜져 있을 때 묶기 전에 실행할 `[commands.fields]` 이름 (예: \"save-all\")",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "ModulePermissions": {
      "additionalProperties": false,
      "description": "`[permissions]` — 모듈 Python 코드가 쓰는 능력 (M12). 선언하지 않은 능력을 코드에서 찾으면 `saba-core module audit`과 `GET /api/module/:name/audit`이 알린다. 새 권한은 여기와 `PERMISSIONS`, `modules/saba_audit.py` 표에 한 줄씩 더한다",
      "properties": {
        "dynamic_code": {
          "default": false,
          "description": "실행 중에 만든 코드 실행 (eval, exec, compile, 동적 __import__, pickle, importlib)",
          "type": "boolean"
        },
        "env_secrets": {
          "default": false,
          "description": "환경 변수 전체 읽기 (dict(os.environ) 등)",
          "type": "boolean"
        },
        "fs_outside_instance": {
          "default": false,
          "description": "서버 작업 폴더 밖의 파일 쓰기 (정적 검사로는 찾지 못한다: 선언만)",
          "type": "boolean"
        },
        "native_code": {
          "default": false,
          "description": "네이티브 코드 (ctypes, cffi, winreg)",
          "type": "boolean"
        },
        "network": {
          "default": false,
          "description": "네트워크 접속 (socket, urllib, requests 등). 데몬 API 호출(daemon_rcon)은 포함하지 않는다",
          "type": "boolean"
        },
        "spawn_process": {
          "default": false,
          "description": "다른 프로그램 실행·프로세스 신호 (subprocess, os.system, os.kill 등)",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "ModulePreset": {
      "additionalProperties": false,
      "description": "`[[presets]]` — 서버를 만들 때 고르는 추천 설정 묶음 (예: \"친구용 소규모\", \"하드코어\"). 표시 문구는 모듈 locales의 `presets.<id>.label`·`description`이 덮는다",
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "description": "소문자·숫자·`-`·`_` (예: \"friends\")",
          "type": "string"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "settings": {
          "additionalProperties": true,
          "default": {},
          "description": "`[[settings.fields]]` 이름 → 값. 비밀번호·파일·경로 설정은 넣지 못한다",
          "type": "object"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "ModuleSection": {
      "additionalProperties": false,
      "properties": {
        "author": {
          "default": null,
